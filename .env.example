# ===== AgentTrace 环境变量示例 =====
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交真实密钥。

# --- LLM（DeepSeek，OpenAI 兼容）---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Embedding（SiliconFlow，OpenAI 兼容；DeepSeek 无 embeddings 接口）---
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- 数据库 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agenttrace
POSTGRES_PASSWORD=agenttrace
POSTGRES_DB=agenttrace

# --- 向量库（M4 接入）---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agenttrace_knowledge

# --- 缓存（M5 接入）---
REDIS_URL=redis://localhost:6379/0

# --- 服务 ---
AGENTTRACE_ENV=dev
LOG_LEVEL=INFO

# --- 诊断任务约束 ---
MAX_PLAN_STEPS=10
MAX_EXECUTION_SECONDS=300
MAX_REFLECTION_ROUNDS=3
